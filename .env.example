# SECURESHADOW Environment Configuration
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.

# ─── Runtime Mode ───────────────────────────────────────────
# Set to "production" to enforce strict secret validation
ENVIRONMENT=development

# ─── Authentication ─────────────────────────────────────────
# JWT signing secret — MUST be changed in production
JWT_SECRET=change-me-to-a-random-64-char-string

# Default admin credentials (used by seed_admin_user on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secureshadowadmin

# ─── Database ───────────────────────────────────────────────
# SQLite (default, for local dev):
DATABASE_URL=sqlite:///./secureshadow.db
# PostgreSQL (for production / Docker):
# DATABASE_URL=postgresql://secureshadow:password@localhost:5432/secureshadow

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for dev only)
CORS_ORIGINS=*

# ─── Background Scheduler ──────────────────────────────────
ENABLE_SCHEDULER=true
SCHEDULED_SCAN_INTERVAL_MINUTES=15
# Path to Terraform plan JSON for scheduled re-scans (optional)
# SCHEDULED_TERRAFORM_PLAN_PATH=/path/to/terraform.json
